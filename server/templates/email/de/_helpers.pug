-   if (name === 'REQUESTED_SEASONS' || name === 'Requested Seasons') {
-     if (typeof value === 'number') return value === 1 ? 'Angefragte Staffel' : 'Angefragte Staffeln'
-     return 'Angefragte Staffeln'
